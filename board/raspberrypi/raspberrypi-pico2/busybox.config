# Applets that cannot work on this kernel.  The rootfs partition has only a few
# KiB of headroom and busybox is ~60% of it, so dead code here is not free.
#
# CONFIG_NET=n: no sockets at all.
# CONFIG_IP is not set
# CONFIG_IPADDR is not set
# CONFIG_IPLINK is not set
# CONFIG_IPROUTE is not set
# CONFIG_IFCONFIG is not set
# CONFIG_IFUP is not set
# CONFIG_IFDOWN is not set
# CONFIG_ROUTE is not set
# CONFIG_NETSTAT is not set
# CONFIG_PING is not set
# CONFIG_NC is not set
# CONFIG_TELNET is not set
# CONFIG_SSL_SERVER is not set
# CONFIG_WGET is not set
# CONFIG_UDHCPC is not set
# CONFIG_FEATURE_IPV6 is not set

# CONFIG_BLOCK=n: no block layer, so no partition probing or mkfs.
# CONFIG_LSBLK is not set
# CONFIG_LSSCSI is not set
# CONFIG_PARTPROBE is not set
# CONFIG_MKE2FS is not set
# CONFIG_MKDOSFS is not set
# CONFIG_NUKE is not set
# CONFIG_FREERAMDISK is not set
# CONFIG_FSFREEZE is not set

# CONFIG_I2C=n.
# CONFIG_I2CTRANSFER is not set

# MTD tools for the writable flash tail (CONFIG_MTD_RP2350_QSPI).  busybox has
# no flash_erase and no mtd_debug, so these two are the whole userspace API:
#   flash_eraseall -j /dev/mtd2   erase + write JFFS2 cleanmarkers (format /data)
#   flashcp -v image /dev/mtd2    erase + write + read back and verify
# ~11 KiB together, which is what the cramfs slot has room for.  flash_lock /
# flash_unlock stay off: the chip's BP bits are clear (the ROM's own UF2 writes
# succeed), so there is nothing to unlock.
CONFIG_FLASH_ERASEALL=y
CONFIG_FLASHCP=y