# /etc/inittab
#
# Copyright (C) 2001 Erik Andersen <andersen@codepoet.org>
#
# Note: BusyBox init doesn't support runlevels.  The runlevels field is
# completely ignored by BusyBox init. If you want runlevels, use
# sysvinit.
#
# Format for each entry: <id>:<runlevels>:<action>:<process>
#
# id        == tty to run on, or empty for /dev/console
# runlevels == ignored
# action    == one of sysinit, respawn, askfirst, wait, and once
# process   == program to run

# Startup the system
::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mkdir -p /dev/pts
::sysinit:/bin/mount -a
# /run is a ramfs mount from fstab, so this now succeeds; it used to run
# against the read-only cramfs and fail with EROFS.
::sysinit:/bin/mkdir -p /run/lock/subsys

console::respawn:/bin/sh

# Neither rcS nor rcK is run: there are no services on this board.  S40network
# and S01seedrng are no longer even installed (BR2_PACKAGE_IFUPDOWN_SCRIPTS /
# BR2_PACKAGE_URANDOM_SCRIPTS off) -- they need ifup/ifdown (CONFIG_NET=n) and a
# persistent writable /var/lib/seedrng (read-only cramfs) respectively.  rcS,
# rcK and S11modules still ship because BR2_INIT_BUSYBOX mandatorily selects
# BR2_PACKAGE_INITSCRIPTS; leaving them uninvoked is deliberate.  Running rcK at
# shutdown used to execute S11modules, whose `ls -A` needs a contiguous ~444KB
# bFLT allocation and can fail with order:7 ENOMEM once memory is fragmented.

#::sysinit:/sbin/swapon -a
#null::sysinit:/bin/ln -sf /proc/self/fd /dev/fd
#null::sysinit:/bin/ln -sf /proc/self/fd/0 /dev/stdin
#null::sysinit:/bin/ln -sf /proc/self/fd/1 /dev/stdout
#null::sysinit:/bin/ln -sf /proc/self/fd/2 /dev/stderr
#::sysinit:/bin/hostname -F /etc/hostname

# Put a getty on the serial port
#console::respawn:/sbin/getty -L  console 0 vt100 # GENERIC_SERIAL

# Stuff to do for the 3-finger salute
#::ctrlaltdel:/sbin/reboot

# Stuff to do before rebooting.  No rcK: see the comment above the shell entry.
#::shutdown:/sbin/swapoff -a
::shutdown:/bin/umount -a -r
