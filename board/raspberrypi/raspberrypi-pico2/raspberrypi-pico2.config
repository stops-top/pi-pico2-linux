CONFIG_CMDLINE="earlycon=pl011,mmio32,0x40070000 console=ttyAMA0 root=mtd:cramfs rootfstype=cramfs ro"
CONFIG_ARCH_VIRT=n
CONFIG_ARCH_RP2350=y
CONFIG_GOLDFISH=n
# Was forced off by a malformed nested entry in the ARCH_RP2350 Kconfig block;
# pin it here now that the block is well-formed. Saves the percpu irq/softirq
# stacks, which this 5 MiB system cannot spare.
CONFIG_IRQ_STACKS=n

CONFIG_CMDLINE_FALLBACK=y
# CONFIG_CMDLINE_FORCE is not set
# CONFIG_DEBUG_INFO_NONE is not set
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_GDB_SCRIPTS=y
CONFIG_MULTIUSER=n
CONFIG_RSEQ=n
CONFIG_LOG_BUF_SHIFT=14
CONFIG_SECCOMP=n
CONFIG_LD_DEAD_CODE_DATA_ELIMINATION=y
CONFIG_RANDOMIZE_KSTACK_OFFSET=n
CONFIG_STACKPROTECTOR_STRONG=n
CONFIG_SMP=n
CONFIG_RISCV_ISA_V=n
# Hazard3 is RV32IMAC, so C is real silicon support (userspace is already built
# with the toolchain's default rv32imc).  Every other consumer of this symbol --
# KGDB, KPROBES, UPROBES, BPF JIT, DYNAMIC_FTRACE patchable-entry sizing -- is
# disabled here and RELOCATABLE=n, so this only buys code density.
CONFIG_RISCV_ISA_C=y
CONFIG_RISCV_ISA_ZAWRS=n
CONFIG_RISCV_ISA_ZABHA=n
CONFIG_RISCV_ISA_ZACAS=n
# Hazard3 implements RV32IMAC + Zicsr + Zifencei only; enabling any Zb* puts
# those into the kernel's global -march, so gcc emits clz/ctz/cpop into plain
# functions that run before earlycon and the kernel dies on an illegal instruction.
CONFIG_RISCV_ISA_ZBA=n
CONFIG_RISCV_ISA_ZBB=n
CONFIG_RISCV_ISA_ZBKB=n
CONFIG_RISCV_ISA_ZICBOZ=n
CONFIG_FPU=n
CONFIG_FILE_LOCKING=n
CONFIG_EXT4_FS=n
CONFIG_EXT2_FS=n
CONFIG_BLK_DEV_INITRD=n
CONFIG_PHYS_RAM_BASE_FIXED=y
CONFIG_PHYS_RAM_BASE=0x11000000
CONFIG_SIMPLE_INTC=y
CONFIG_RELOCATABLE=n

CONFIG_BLOCK=n
CONFIG_VIRTIO_BLK=n
CONFIG_VIRTIO_MMIO=n
CONFIG_SERIAL_8250=n
CONFIG_LEGACY_TIOCSTI=n


CONFIG_SUSPEND=n
CONFIG_PM=n

CONFIG_CRC_OPTIMIZATIONS=n

CONFIG_DEBUG_BUGVERBOSE=n

