Subject: [PATCH] rp2350: mask interrupts around the bare lw/sw RMW sequences

0003 turned the lr/sc loops into plain lw/sw, which is not interruptible: an
interrupt taken between the load and the store can observe and re-enter the
same lock/counter. Wrap the remaining bare read-modify-write sequences
(_arch_atomic_{fetch_add_unless,inc_unless_negative,dec_unless_positive,
dec_if_positive}, the _arch_xchg / _arch_cmpxchg dispatchers and
futex_atomic_cmpxchg_inatomic) in arch_local_irq_save()/restore(), which is
what 0007 already does for the AMO forms.

---
--- a/arch/riscv/include/asm/futex.h	2026-11-04 15:05:14.186068538 +0800
+++ b/arch/riscv/include/asm/futex.h	2026-11-04 15:00:30.289487260 +0800
@@ -79,10 +79,12 @@
 	int ret = 0;
 	u32 val;
 	uintptr_t tmp;
+	unsigned long flags;
 
 	if (!access_ok(uaddr, sizeof(u32)))
 		return -EFAULT;
 
+	flags = arch_local_irq_save();
 	__enable_user_access();
 	__asm__ __volatile__ (
 	"1:	lw %[v],%[u]				\n"
@@ -95,6 +97,7 @@
 	: [ov] "Jr" ((long)(int)oldval), [nv] "Jr" (newval)
 	: "memory");
 	__disable_user_access();
+	arch_local_irq_restore(flags);
 
 	*uval = val;
 	return ret;
--- a/arch/riscv/include/asm/atomic.h	2026-11-04 15:05:14.186068538 +0800
+++ b/arch/riscv/include/asm/atomic.h	2026-11-04 14:58:56.183533387 +0800
@@ -17,6 +17,7 @@
 #endif
 
 #include <asm/cmpxchg.h>
+#include <asm/irqflags.h>
 
 #define __atomic_acquire_fence()					\
 	__asm__ __volatile__(RISCV_ACQUIRE_BARRIER "" ::: "memory")
@@ -217,8 +218,15 @@
 {
        int prev, rc;
 
+	{
+		unsigned long __f = arch_local_irq_save();
+
 	_arch_atomic_fetch_add_unless(prev, rc, v->counter, a, u, "w");
 
+		arch_local_irq_restore(__f);
+	}
+
+
 	return prev;
 }
 #define arch_atomic_fetch_add_unless arch_atomic_fetch_add_unless
@@ -254,8 +262,15 @@
 {
 	int prev, rc;
 
+	{
+		unsigned long __f = arch_local_irq_save();
+
 	_arch_atomic_inc_unless_negative(prev, rc, v->counter, "w");
 
+		arch_local_irq_restore(__f);
+	}
+
+
 	return !(prev < 0);
 }
 
@@ -279,8 +294,15 @@
 {
 	int prev, rc;
 
+	{
+		unsigned long __f = arch_local_irq_save();
+
 	_arch_atomic_dec_unless_positive(prev, rc, v->counter, "w");
 
+		arch_local_irq_restore(__f);
+	}
+
+
 	return !(prev > 0);
 }
 
@@ -304,8 +326,15 @@
 {
        int prev, rc;
 
+	{
+		unsigned long __f = arch_local_irq_save();
+
 	_arch_atomic_dec_if_positive(prev, rc, v->counter, "w");
 
+		arch_local_irq_restore(__f);
+	}
+
+
 	return prev - 1;
 }
 
--- a/arch/riscv/include/asm/cmpxchg.h	2026-11-04 15:05:14.186068538 +0800
+++ b/arch/riscv/include/asm/cmpxchg.h	2026-11-04 14:59:30.611054176 +0800
@@ -71,7 +71,9 @@
 	__typeof__(ptr) __ptr = (ptr);					\
 	__typeof__(*(__ptr)) __new = (new);				\
 	__typeof__(*(__ptr)) __ret;					\
+	unsigned long __flags;						\
 									\
+	__flags = arch_local_irq_save();					\
 	switch (sizeof(*__ptr)) {					\
 	case 1:								\
 		__arch_xchg_masked(sc_sfx, ".b" swap_sfx,		\
@@ -94,6 +96,7 @@
 	default:							\
 		BUILD_BUG();						\
 	}								\
+	arch_local_irq_restore(__flags);					\
 	(__typeof__(*(__ptr)))__ret;					\
 })
 
@@ -214,7 +217,9 @@
 	__typeof__(*(__ptr)) __old = (old);				\
 	__typeof__(*(__ptr)) __new = (new);				\
 	__typeof__(*(__ptr)) __ret;					\
+	unsigned long __flags;						\
 									\
+	__flags = arch_local_irq_save();					\
 	switch (sizeof(*__ptr)) {					\
 	case 1:								\
 		__arch_cmpxchg_masked(sc_sfx, ".b" cas_sfx,		\
@@ -243,6 +248,7 @@
 	default:							\
 		BUILD_BUG();						\
 	}								\
+	arch_local_irq_restore(__flags);					\
 	(__typeof__(*(__ptr)))__ret;					\
 })
 
