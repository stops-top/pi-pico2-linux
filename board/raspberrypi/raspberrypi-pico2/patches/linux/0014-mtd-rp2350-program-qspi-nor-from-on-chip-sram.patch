--- /dev/null
+++ b/drivers/mtd/devices/rp2350-qspi.c
@@ -0,0 +1,360 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MTD driver for the NOR flash on the RP2350's QMI CS0.
+ *
+ * The kernel runs from PSRAM on CS1 and never reads flash through the XIP
+ * window, so every access here goes through QMI direct mode from the SRAM
+ * routine in rp2350-qspi-sram.c.  Erase and program are split into "start" and
+ * "poll status" so the chip's millisecond-scale busy time is spent with
+ * interrupts enabled and the kernel running normally; only the few tens of
+ * microseconds of actual SPI traffic run with interrupts masked.
+ *
+ * Copyright (C) 2026
+ */
+
+#include <linux/delay.h>
+#include <linux/errno.h>
+#include <linux/io.h>
+#include <linux/jiffies.h>
+#include <linux/kernel.h>
+#include <linux/minmax.h>
+#include <linux/module.h>
+#include <linux/mtd/mtd.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+
+#include "rp2350-qspi.h"
+
+#define RP2350_XIP_BASE		0x10000000UL
+#define RP2350_SECTOR_SIZE	0x1000U
+#define RP2350_BLOCK_SIZE	0x10000U
+/* Covers the 2 s worst-case 64 KiB block erase with margin. */
+#define RP2350_READY_TIMEOUT_MS	3000
+/* Page program is 0.7 ms typical, 3 ms max; 50 us is 14 polls worst case. */
+#define RP2350_STATUS_POLL_US	50
+
+extern char __sramtext_start[], __sramtext_end[];
+
+/* The args block grows with RP2350_SRAM_BUF_SIZE; make sure it still fits after
+ * the code and stack regions. */
+static_assert(offsetof(struct rp2350_sram_args, buf) + RP2350_SRAM_BUF_SIZE <=
+	      RP2350_SRAM_SIZE - RP2350_SRAM_ARGS_OFF);
+
+struct rp2350_qspi {
+	struct device *dev;
+	struct mtd_info mtd;
+	/* Serialises the single SRAM args block and the QMI direct window. */
+	struct mutex lock;
+	void *sram;
+	unsigned long entry;
+	unsigned long payload;
+	unsigned long stack_top;
+	struct rp2350_sram_args *args;
+};
+
+static int rp2350_run(struct rp2350_qspi *q, u32 op, u32 offset, u32 len)
+{
+	typedef u32 (*entry_t)(unsigned long sp, void *fn, void *args);
+	struct rp2350_sram_args *a = q->args;
+	unsigned long flags;
+	u32 ret;
+
+	a->op = op;
+	a->offset = offset;
+	a->len = len;
+	a->status = 0;
+
+	local_irq_save(flags);
+	ret = ((entry_t)q->entry)(q->stack_top, (void *)q->payload, a);
+	local_irq_restore(flags);
+
+	if (ret) {
+		dev_err(q->dev, "flash op %u at 0x%08x failed: %u\n",
+			op, offset, ret);
+		return -EIO;
+	}
+	return 0;
+}
+
+/* Called with q->lock held.  Between polls the flash is busy but CS0 is high,
+ * so the kernel is free to run: it only ever touches CS1.
+ *
+ * spin=true is for page programs: they finish in ~0.7 ms, and with HZ=250 and
+ * no high-resolution timers usleep_range() rounds up to a whole 4 ms jiffy, so
+ * sleeping would make a 256-byte page take six times longer than the work.
+ * udelay() reads the 1 MHz time CSR and is exact here.  Erases are 45 ms to
+ * 2 s, so they sleep instead of burning the CPU. */
+static int rp2350_wait_ready(struct rp2350_qspi *q, bool spin)
+{
+	unsigned long deadline = jiffies + msecs_to_jiffies(RP2350_READY_TIMEOUT_MS);
+
+	for (;;) {
+		int ret = rp2350_run(q, RP2350_OP_READ_STATUS, 0, 1);
+
+		if (ret)
+			return ret;
+		if (!(q->args->status & RP2350_STATUS_WIP))
+			return 0;
+		if (time_after(jiffies, deadline)) {
+			dev_err(q->dev, "flash still busy after %u ms\n",
+				RP2350_READY_TIMEOUT_MS);
+			return -ETIMEDOUT;
+		}
+		if (spin)
+			udelay(RP2350_STATUS_POLL_US);
+		else
+			usleep_range(1000, 2000);
+	}
+}
+
+static int rp2350_read(struct mtd_info *mtd, loff_t from, size_t len,
+		       size_t *retlen, u_char *buf)
+{
+	struct rp2350_qspi *q = mtd->priv;
+	size_t done = 0;
+	int ret = 0;
+
+	*retlen = 0;
+	if (from < 0 || len > mtd->size - from)
+		return -EINVAL;
+
+	mutex_lock(&q->lock);
+	while (done < len) {
+		u32 n = min_t(size_t, len - done, RP2350_SRAM_BUF_SIZE);
+
+		ret = rp2350_run(q, RP2350_OP_READ, (u32)(from + done), n);
+		if (ret)
+			break;
+		memcpy(buf + done, q->args->buf, n);
+		done += n;
+	}
+	mutex_unlock(&q->lock);
+
+	*retlen = done;
+	return ret;
+}
+
+/* Called with q->lock held.  The bootloader needed a read-back on every flash
+ * copy to get stable data out of this bus; hold programmed data to the same
+ * standard rather than trusting the status register alone. */
+static int rp2350_verify(struct rp2350_qspi *q, loff_t off, const u8 *buf,
+			 size_t len)
+{
+	size_t done = 0;
+
+	while (done < len) {
+		u32 n = min_t(size_t, len - done, RP2350_SRAM_BUF_SIZE);
+		int ret = rp2350_run(q, RP2350_OP_READ, (u32)(off + done), n);
+
+		if (ret)
+			return ret;
+		if (memcmp(buf + done, q->args->buf, n)) {
+			dev_err(q->dev, "read-back mismatch at 0x%08llx\n",
+				(unsigned long long)(off + done));
+			return -EIO;
+		}
+		done += n;
+	}
+	return 0;
+}
+
+static int rp2350_write(struct mtd_info *mtd, loff_t to, size_t len,
+			size_t *retlen, const u_char *buf)
+{
+	struct rp2350_qspi *q = mtd->priv;
+	size_t done = 0;
+	int ret = 0;
+
+	*retlen = 0;
+	if (to < 0 || len > mtd->size - to)
+		return -EINVAL;
+
+	mutex_lock(&q->lock);
+	while (done < len) {
+		u32 addr = (u32)(to + done);
+		/* A program command wraps inside its 256-byte page instead of
+		 * advancing, so never let one straddle a page boundary. */
+		u32 n = min3(len - done,
+			     (size_t)(RP2350_FLASH_PAGE_SIZE -
+				      (addr & (RP2350_FLASH_PAGE_SIZE - 1))),
+			     (size_t)RP2350_SRAM_BUF_SIZE);
+
+		memcpy(q->args->buf, buf + done, n);
+		ret = rp2350_run(q, RP2350_OP_PAGE_PROGRAM, addr, n);
+		if (ret)
+			break;
+		ret = rp2350_wait_ready(q, true);
+		if (ret)
+			break;
+		done += n;
+	}
+	if (!ret)
+		ret = rp2350_verify(q, to, buf, done);
+	mutex_unlock(&q->lock);
+
+	*retlen = done;
+	return ret;
+}
+
+static int rp2350_erase(struct mtd_info *mtd, struct erase_info *instr)
+{
+	struct rp2350_qspi *q = mtd->priv;
+	u64 addr, end;
+	int ret = 0;
+
+	if (instr->addr >= mtd->size || instr->len > mtd->size - instr->addr)
+		return -EINVAL;
+	if ((instr->addr | instr->len) & (mtd->erasesize - 1))
+		return -EINVAL;
+
+	end = instr->addr + instr->len;
+	mutex_lock(&q->lock);
+	for (addr = instr->addr; addr < end; ) {
+		u32 op = RP2350_OP_SECTOR_ERASE;
+		u32 step = RP2350_SECTOR_SIZE;
+
+		if (!(addr & (RP2350_BLOCK_SIZE - 1)) &&
+		    end - addr >= RP2350_BLOCK_SIZE) {
+			op = RP2350_OP_BLOCK_ERASE;
+			step = RP2350_BLOCK_SIZE;
+		}
+		ret = rp2350_run(q, op, (u32)addr, 0);
+		if (ret)
+			break;
+		ret = rp2350_wait_ready(q, false);
+		if (ret)
+			break;
+		addr += step;
+	}
+	mutex_unlock(&q->lock);
+
+	if (ret)
+		instr->fail_addr = addr;
+	return ret;
+}
+
+static int rp2350_qspi_probe(struct platform_device *pdev)
+{
+	struct device_node *np = pdev->dev.of_node;
+	struct device *dev = &pdev->dev;
+	struct resource *res;
+	struct rp2350_qspi *q;
+	u32 scratch[2];
+	size_t code_size;
+	u32 size;
+	const u8 *id;
+	int ret;
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res)
+		return -EINVAL;
+	if (res->start != RP2350_XIP_BASE) {
+		dev_err(dev, "only CS0 flash at 0x%08lx is supported\n",
+			RP2350_XIP_BASE);
+		return -EINVAL;
+	}
+	size = resource_size(res);
+	if (!size || size & (RP2350_SECTOR_SIZE - 1))
+		return -EINVAL;
+
+	ret = of_property_read_u32_array(np, "sram-scratch", scratch, 2);
+	if (ret)
+		return ret;
+	if (scratch[1] < RP2350_SRAM_SIZE) {
+		dev_err(dev, "sram-scratch must be at least %u bytes\n",
+			RP2350_SRAM_SIZE);
+		return -EINVAL;
+	}
+
+	q = devm_kzalloc(dev, sizeof(*q), GFP_KERNEL);
+	if (!q)
+		return -ENOMEM;
+
+	q->dev = dev;
+	mutex_init(&q->lock);
+	/* On-chip SRAM is ordinary memory that the kernel does not claim, and
+	 * nommu has no page tables, so the physical address is directly
+	 * dereferenceable -- ioremap() would just cast it back anyway. */
+	q->sram = (void *)(uintptr_t)scratch[0];
+	q->args = (struct rp2350_sram_args *)(q->sram + RP2350_SRAM_ARGS_OFF);
+	q->stack_top = (unsigned long)q->sram + RP2350_SRAM_STACK_OFF +
+		       RP2350_SRAM_STACK_SIZE;
+
+	code_size = __sramtext_end - __sramtext_start;
+	if (code_size > RP2350_SRAM_CODE_MAX) {
+		dev_err(dev, ".sramtext is %zu bytes, only %u fit in SRAM\n",
+			code_size, RP2350_SRAM_CODE_MAX);
+		return -EINVAL;
+	}
+	memcpy(q->sram + RP2350_SRAM_CODE_OFF, __sramtext_start, code_size);
+	asm volatile("fence.i" ::: "memory");
+
+	q->entry = (unsigned long)q->sram + RP2350_SRAM_CODE_OFF;
+	q->payload = q->entry + ((unsigned long)rp2350_sram_payload -
+				 (unsigned long)__sramtext_start);
+	platform_set_drvdata(pdev, q);
+
+	ret = rp2350_run(q, RP2350_OP_JEDEC_ID, 0, 3);
+	if (ret)
+		return ret;
+	id = q->args->buf;
+	if ((id[0] == 0xff && id[1] == 0xff && id[2] == 0xff) ||
+	    (id[0] == 0x00 && id[1] == 0x00 && id[2] == 0x00)) {
+		dev_err(dev, "no flash on CS0 (ID %02x %02x %02x)\n",
+			id[0], id[1], id[2]);
+		return -ENODEV;
+	}
+	dev_info(dev, "CS0 flash ID %02x %02x %02x, %u KiB, %u KiB erase\n",
+		 id[0], id[1], id[2], size / 1024, RP2350_SECTOR_SIZE / 1024);
+
+	q->mtd.name = "rp2350-flash";
+	q->mtd.owner = THIS_MODULE;
+	q->mtd.type = MTD_NORFLASH;
+	q->mtd.flags = MTD_CAP_NORFLASH;
+	q->mtd.size = size;
+	q->mtd.erasesize = RP2350_SECTOR_SIZE;
+	q->mtd.writesize = 1;
+	q->mtd.oobsize = 0;
+	q->mtd.priv = q;
+	q->mtd._read = rp2350_read;
+	q->mtd._write = rp2350_write;
+	q->mtd._erase = rp2350_erase;
+	q->mtd.dev.parent = dev;
+	mtd_set_of_node(&q->mtd, np);
+
+	ret = mtd_device_register(&q->mtd, NULL, 0);
+	if (ret) {
+		dev_err(dev, "failed to register MTD device: %d\n", ret);
+		return ret;
+	}
+
+	return 0;
+}
+
+static void rp2350_qspi_remove(struct platform_device *pdev)
+{
+	struct rp2350_qspi *q = platform_get_drvdata(pdev);
+
+	mtd_device_unregister(&q->mtd);
+}
+
+static const struct of_device_id rp2350_qspi_of_match[] = {
+	{ .compatible = "raspberrypi,rp2350-qspi-flash" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, rp2350_qspi_of_match);
+
+static struct platform_driver rp2350_qspi_driver = {
+	.probe	= rp2350_qspi_probe,
+	.remove	= rp2350_qspi_remove,
+	.driver	= {
+		.name		= "rp2350-qspi",
+		.of_match_table	= rp2350_qspi_of_match,
+	},
+};
+module_platform_driver(rp2350_qspi_driver);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("RP2350 QMI CS0 NOR flash, programmed from on-chip SRAM");
